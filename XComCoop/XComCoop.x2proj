    <Title>XCOM 2 WotC Co-op</Title>
    <Description>TEST BUILD - work in progress, not playable yet. Co-op campaign and tactical play for XCOM 2: War of the Chosen. Requires X2WOTCCommunityHighlander.</Description>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
